{
  "id": "previews",
  "name": "Inbox",
  "version": "1.1.0",
  "description": "A thread hands you commands to run, links, files to look at and text to copy: a badge, a sheet on the phone, a history on the desktop.",
  "author": "dispatch",
  "dispatch": ">=3.27",
  "sdk": 2,
  "web": "web.js",
  "enabledByDefault": true,
  "contributes": {
    "views": [{ "id": "history", "label": "Inbox", "icon": "tray" }],
    "inspectorTabs": [{ "id": "thread", "label": "Inbox" }],
    "projectMenu": [{ "id": "open", "label": "Inbox" }],
    "slots": ["project.header.actions", "thread.header.actions", "app.overlay"]
  },
  "permissions": ["threads:read-storage", "threads:write-storage"],
  "model": {
    "instructions": "instructions.md",
    "mcp": { "command": "node", "args": ["mcp/server.mjs"] }
  }
}
