{
  "id": "daily-rundown",
  "name": "Daily rundown",
  "version": "0.1.0",
  "description": "What happened in the last day, per project.",
  "web": "web.js",
  "contributes": {
    "views": [
      {
        "id": "rundown",
        "label": "Rundown",
        "icon": "sun"
      }
    ],
    "settings": [
      {
        "id": "rundown",
        "label": "Daily rundown"
      }
    ],
    "threadMenu": [
      {
        "id": "pin",
        "label": "Pin to rundown"
      }
    ]
  },
  "permissions": [
    "read:threads",
    "threads:call-worker"
  ],
  "worker": {
    "command": "node",
    "args": [
      "worker/index.mjs"
    ],
    "jobs": [
      {
        "id": "morning",
        "cron": "0 7 * * 1-5"
      }
    ]
  }
}
